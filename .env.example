# 复制本文件为 .env 后使用（.env 已被 .gitignore 忽略，不会提交敏感信息）
# 所有变量也可直接作为系统环境变量设置，优先级：环境变量 > .env > config.yaml

# ---- 聊天接入 ----
QQBOT_ADAPTER=onebot11
QQBOT_MODE=reverse
# 反向 WS（本项目作服务端，协议端连过来）：
QQBOT_HOST=127.0.0.1
QQBOT_PORT=8080
QQBOT_PATH=/onebot/v11/ws
# 正向 WS（本项目作客户端，主动连协议端）：
QQBOT_WS_URL=ws://127.0.0.1:3001/
# OneBot 鉴权 token（协议端若启用，需一致）
QQBOT_ACCESS_TOKEN=

# ---- 业务逻辑 ----
QQBOT_HANDLER=echo

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 日志 ----
QQBOT_LOG_LEVEL=INFO
QQBOT_LOG_FILE=logs/qqbot.log
